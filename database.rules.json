{
  "rules": {
    ".read": false,
    ".write": false,
    "devices": {
      "$id": {
        ".read": "$id.matches(/^exo-[0-9]{2}$/)",
        "live": {
          ".write": "$id.matches(/^exo-[0-9]{2}$/)",
          ".validate": "newData.hasChildren(['angle', 'assist', 'hr', 'reps', 'ts'])",
          "angle":   { ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 180" },
          "assist":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "effort":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "hr":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250" },
          "reps":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "battery": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "t":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ts":      { ".validate": "newData.isNumber()" },
          "mode":    { ".validate": "newData.isString() && newData.val().length <= 16" },
          "source":  { ".validate": "newData.isString() && newData.val().length <= 16" },
          "emg":     { "$i": { ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber()" } },
          "$other":  { ".validate": false }
        },
        "config": {
          ".write": "$id.matches(/^exo-[0-9]{2}$/)",
          "mode":           { ".validate": "newData.isString() && newData.val().matches(/^(passive|aan|active)$/)" },
          "maxFlexion":     { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 140" },
          "aiAdaptive":     { ".validate": "newData.isBoolean()" },
          "spasmStop":      { ".validate": "newData.isBoolean()" },
          "shareTherapist": { ".validate": "newData.isBoolean()" },
          "$other":         { ".validate": false }
        },
        "sessions": {
          ".indexOn": ["ts"],
          "$sid": {
            ".write": "$id.matches(/^exo-[0-9]{2}$/) && !data.exists()",
            ".validate": "newData.hasChildren(['ts', 'reps', 'maxAngle', 'effort', 'durationS', 'source'])",
            "ts":        { ".validate": "newData.isNumber()" },
            "reps":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "maxAngle":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 180" },
            "effort":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "durationS": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "source":    { ".validate": "newData.isString() && newData.val().matches(/^(device|demo|sim)$/)" },
            "$other":    { ".validate": false }
          }
        }
      }
    }
  }
}
